<script type="text/javascript">
require([
    'jquery'
], function($) {
    // Store reasons and conditions by type
    var reasonsByType = {
        'exchange': <?php echo json_encode(array_map(function($r) { return ['value' => $r->getTitle(), 'label' => $r->getTitle()]; }, iterator_to_array($this->getReasons('exchange')))); ?>,
        'return': <?php echo json_encode(array_map(function($r) { return ['value' => $r->getTitle(), 'label' => $r->getTitle()]; }, iterator_to_array($this->getReasons('return')))); ?>
    };

    var conditionsByType = {
        'exchange': <?php echo json_encode(array_map(function($c) { return ['value' => $c->getTitle(), 'label' => $c->getTitle()]; }, iterator_to_array($this->getConditions('exchange')))); ?>,
        'return': <?php echo json_encode(array_map(function($c) { return ['value' => $c->getTitle(), 'label' => $c->getTitle()]; }, iterator_to_array($this->getConditions('return')))); ?>
    };

    function updateReasonsAndConditions(rmaType) {
        // Update all reason dropdowns
        $('.reason').each(function() {
            var $select = $(this);
            var itemId = $select.data('item-id');
            var currentValue = $select.val();
            
            $select.empty();
            $select.append('<option value=""><?php echo __('Please Select'); ?></option>');
            
            $.each(reasonsByType[rmaType], function(index, reason) {
                $select.append($('<option></option>').attr('value', reason.value).text(reason.label));
            });
        });

        // Update all condition dropdowns
        $('.condition').each(function() {
            var $select = $(this);
            var itemId = $select.data('item-id');
            var currentValue = $select.val();
            
            $select.empty();
            $select.append('<option value=""><?php echo __('Please Select'); ?></option>');
            
            $.each(conditionsByType[rmaType], function(index, condition) {
                $select.append($('<option></option>').attr('value', condition.value).text(condition.label));
            });
        });
    }

    // Initialize with default type (exchange)
    updateReasonsAndConditions('exchange');

    // Handle RMA type change
    $('.rma-type-radio').on('change', function() {
        var selectedType = $(this).val();
        updateReasonsAndConditions(selectedType);
    });

    // Form validation
    $('#submit-return').on('submit', function(e) {
        var hasChecked = false;
        var isValid = true;
        var errorMessage = '';

        // Check if at least one item is selected
        $('input[name^="check"]').each(function() {
            if($(this).is(':checked')) {
                hasChecked = true;
                var itemId = $(this).closest('.block-item').find('input[name^="item_id"]').val().match(/\d+/)[0];
                
                // Check if reason is selected
                if($('select[name="reason[' + itemId + ']"]').val() == '') {
                    isValid = false;
                    errorMessage = '<?php echo __('Please select reason for all selected products.'); ?>';
                    return false;
                }
                
                // Check if condition is selected
                if($('select[name="condition[' + itemId + ']"]').val() == '') {
                    isValid = false;
                    errorMessage = '<?php echo __('Please select condition for all selected products.'); ?>';
                    return false;
                }
            }
        });

        if(!hasChecked) {
            alert('<?php echo __('Please select at least one item.'); ?>');
            e.preventDefault();
            return false;
        }

        if(!isValid) {
            alert(errorMessage);
            e.preventDefault();
            return false;
        }
    });
});
</script>

