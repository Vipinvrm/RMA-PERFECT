<script type="text/x-magento-init">
{
    "#rma-generate-form": {
        "Magento_Ui/js/core/app": {
            "components": {
                "rmaForm": {
                    "component": "Krishaweb_Rma/js/rma-form"
                }
            }
        }
    }
}
</script>

<script>
require([
    'jquery',
    'mage/validation'
], function($) {
    'use strict';

    var uploadedImages = {};
    var rmaType = '';

    // RMA Type change handler
    $('#rma_type').on('change', function() {
        rmaType = $(this).val();
        loadReasonsAndConditions(rmaType);
    });

    // Load reasons and conditions based on RMA type
    function loadReasonsAndConditions(type) {
        if (!type) return;

        $.ajax({
            url: '<?php echo $this->getUrl('rma/rma/getOptions'); ?>',
            type: 'POST',
            data: { rma_type: type },
            dataType: 'json',
            success: function(response) {
                if (response.success) {
                    updateReasonSelects(response.reasons, type);
                    updateConditionSelects(response.conditions, type);
                }
            }
        });
    }

    function updateReasonSelects(reasons, type) {
        $('.reason-select').each(function() {
            var $select = $(this);
            var currentValue = $select.val();
            
            // Clear options except first
            $select.find('option:not(:first)').remove();
            
            // Add placeholder
            var placeholderClass = type === 'exchange' ? 'reason-placeholder-exchange' : 'reason-placeholder-return';
            $select.find('.' + placeholderClass).show();
            
            // Add options
            $.each(reasons, function(index, reason) {
                $select.append($('<option></option>')
                    .attr('value', reason.title)
                    .text(reason.title));
            });

            // Add "Other" option
            $select.append($('<option></option>')
                .attr('value', 'Other')
                .text('<?php echo __('Other (Please Specify)'); ?>'));
        });
    }

    function updateConditionSelects(conditions, type) {
        $('.condition-select').each(function() {
            var $select = $(this);
            
            // Clear options except first
            $select.find('option:not(:first)').remove();
            
            // Add placeholder
            var placeholderClass = type === 'exchange' ? 'condition-placeholder-exchange' : 'condition-placeholder-return';
            $select.find('.' + placeholderClass).show();
            
            // Add options
            $.each(conditions, function(index, condition) {
                $select.append($('<option></option>')
                    .attr('value', condition.title)
                    .text(condition.title));
            });

            // Add "Other" option
            $select.append($('<option></option>')
                .attr('value', 'Other')
                .text('<?php echo __('Other (Please Specify)'); ?>'));
        });
    }

    // Handle reason "Other" selection
    $(document).on('change', '.reason-select', function() {
        var $select = $(this);
        var itemId = $select.data('item-id');
        var $otherContainer = $select.closest('td').find('.reason-other-container');
        
        if ($select.val() === 'Other') {
            $otherContainer.show();
            $otherContainer.find('textarea').prop('required', true);
        } else {
            $otherContainer.hide();
            $otherContainer.find('textarea').prop('required', false).val('');
        }
    });

    // Handle condition "Other" selection
    $(document).on('change', '.condition-select', function() {
        var $select = $(this);
        var itemId = $select.data('item-id');
        var $otherContainer = $select.closest('td').find('.condition-other-container');
        
        if ($select.val() === 'Other') {
            $otherContainer.show();
            $otherContainer.find('textarea').prop('required', true);
        } else {
            $otherContainer.hide();
            $otherContainer.find('textarea').prop('required', false).val('');
        }
    });

    // Image upload trigger
    $(document).on('click', '.upload-trigger', function() {
        $(this).closest('.image-upload-container').find('.image-upload-input').click();
    });

    // Handle image selection
    $(document).on('change', '.image-upload-input', function(e) {
        var files = e.target.files;
        var $container = $(this).closest('.image-upload-container');
        var itemId = $container.data('item-id');
        
        if (!uploadedImages[itemId]) {
            uploadedImages[itemId] = [];
        }

        // Check if adding these files exceeds limit
        if (uploadedImages[itemId].length + files.length > 3) {
            alert('<?php echo __('You can upload maximum 3 images per item.'); ?>');
            return;
        }

        // Upload each file
        for (var i = 0; i < files.length; i++) {
            if (uploadedImages[itemId].length >= 3) {
                break;
            }
            uploadImage(files[i], itemId, $container);
        }

        // Clear input
        $(this).val('');
    });

    function uploadImage(file, itemId, $container) {
        // Validate file size (5MB)
        if (file.size > 5 * 1024 * 1024) {
            alert('<?php echo __('File size exceeds 5MB: '); ?>' + file.name);
            return;
        }

        // Validate file type
        if (!file.type.match('image/(jpeg|png|gif)')) {
            alert('<?php echo __('Invalid file type. Only JPG, PNG and GIF are allowed: '); ?>' + file.name);
            return;
        }

        var formData = new FormData();
        formData.append('rma_image', file);
        formData.append('form_key', '<?php echo $block->getFormKey(); ?>');

        $.ajax({
            url: '<?php echo $this->getUrl('rma/rma/upload'); ?>',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            dataType: 'json',
            beforeSend: function() {
                $container.find('.upload-trigger').prop('disabled', true).text('<?php echo __('Uploading...'); ?>');
            },
            success: function(response) {
                if (response.error) {
                    alert(response.message);
                } else {
                    uploadedImages[itemId].push(response.path);
                    addImagePreview($container, response.url, response.path, itemId);
                }
            },
            error: function() {
                alert('<?php echo __('An error occurred while uploading the image.'); ?>');
            },
            complete: function() {
                $container.find('.upload-trigger').prop('disabled', false).text('<?php echo __('Upload Images'); ?>');
            }
        });
    }

    function addImagePreview($container, url, path, itemId) {
        var $preview = $('<div class="image-preview-item"></div>');
        var $img = $('<img>').attr('src', url);
        var $removeBtn = $('<button type="button" class="remove-image">×</button>');
        
        $removeBtn.on('click', function() {
            removeImage(itemId, path);
            $preview.remove();
        });

        $preview.append($img).append($removeBtn);
        $container.find('.uploaded-images-preview').append($preview);

        // Add hidden input for this image
        var $hiddenInput = $('<input type="hidden">');
        $hiddenInput.attr('name', 'images[' + itemId + '][]');
        $hiddenInput.attr('value', path);
        $hiddenInput.attr('data-image-path', path);
        $container.append($hiddenInput);
    }

    function removeImage(itemId, path) {
        var index = uploadedImages[itemId].indexOf(path);
        if (index > -1) {
            uploadedImages[itemId].splice(index, 1);
        }

        // Remove hidden input
        $('input[data-image-path="' + path + '"]').remove();
    }

    // Form validation
    $('#rma-generate-form').mage('validation', {
        errorPlacement: function(error, element) {
            error.insertAfter(element.closest('.control, td'));
        }
    });

    // Custom validation before submit
    $('#rma-generate-form').on('submit', function(e) {
        var hasCheckedItem = false;
        var isValid = true;

        $('.item-checkbox:checked').each(function() {
            hasCheckedItem = true;
            var itemId = $(this).data('item-id');
            var $row = $(this).closest('tr');

            // Check if images are uploaded (minimum 1)
            if (!uploadedImages[itemId] || uploadedImages[itemId].length < 1) {
                alert('<?php echo __('Please upload at least 1 image for the selected item.'); ?>');
                isValid = false;
                return false;
            }

            // Check quantity
            var qty = $row.find('.qty-input').val();
            if (!qty || qty < 1) {
                alert('<?php echo __('Please enter a valid quantity for the selected item.'); ?>');
                isValid = false;
                return false;
            }

            // Check reason
            var reason = $row.find('.reason-select').val();
            if (!reason) {
                alert('<?php echo __('Please select a reason for the selected item.'); ?>');
                isValid = false;
                return false;
            }

            // Check "Other" reason text
            if (reason === 'Other') {
                var reasonText = $row.find('.reason-other-text').val().trim();
                if (!reasonText) {
                    alert('<?php echo __('Please specify the reason when selecting "Other".'); ?>');
                    isValid = false;
                    return false;
                }
            }

            // Check condition
            var condition = $row.find('.condition-select').val();
            if (!condition) {
                alert('<?php echo __('Please select a condition for the selected item.'); ?>');
                isValid = false;
                return false;
            }

            // Check "Other" condition text
            if (condition === 'Other') {
                var conditionText = $row.find('.condition-other-text').val().trim();
                if (!conditionText) {
                    alert('<?php echo __('Please specify the condition when selecting "Other".'); ?>');
                    isValid = false;
                    return false;
                }
            }
        });

        if (!hasCheckedItem) {
            alert('<?php echo __('Please select at least one item.'); ?>');
            return false;
        }

        if (!rmaType) {
            alert('<?php echo __('Please select RMA Type (Exchange or Return).'); ?>');
            return false;
        }

        return isValid;
    });
});
</script>