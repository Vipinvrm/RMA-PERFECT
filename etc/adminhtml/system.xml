<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
	<system>
		<tab id="configuration" translate="label" sortOrder="1000">
			<label>Rma</label>
		</tab>
		<section id="rma" translate="label" sortOrder="1" showInDefault="1" showInWebsite="0" showInStore="0">
			<class>separator-top</class>
			<label>Configuration</label>
			<tab>configuration</tab>
			<resource>Krishaweb_Rma::configuration</resource>
			
			<!-- RMA Options -->
			<group id="options" translate="label" type="text" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
				<label>RMA Options</label>
				<field id="allow_return" translate="label" type="select" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
					<label>Allow Status to Return</label>
                    <source_model>Krishaweb\Rma\Model\Config\Source\Status</source_model>
				</field>
				<field id="rma_days_limit" translate="label comment" type="text" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
					<label>RMA Request Days Limit</label>
					<comment>Number of days after delivery within which RMA can be requested (e.g., 14 for 14 days)</comment>
					<validate>required-entry validate-digits validate-greater-than-zero</validate>
				</field>
			</group>
			
			<!-- Shipment Automation Options -->
			<group id="shipment_automation" translate="label" type="text" sortOrder="3" showInDefault="1" showInWebsite="1" showInStore="1">
				<label>Shipment Automation</label>
				<field id="auto_change_status" translate="label comment" type="select" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
					<label>Auto Change Order Status on Shipment</label>
					<source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
					<comment>Automatically change order status to "Shipped" when shipment is created</comment>
				</field>
				<field id="target_status" translate="label comment" type="text" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
					<label>Target Status Code</label>
					<comment>Status code to set when shipment is created (default: "shipped"). Make sure this status exists in your system.</comment>
					<depends>
						<field id="auto_change_status">1</field>
					</depends>
				</field>
				<field id="add_comment" translate="label comment" type="select" sortOrder="3" showInDefault="1" showInWebsite="1" showInStore="1">
					<label>Add Status History Comment</label>
					<source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
					<comment>Add a comment to order status history when status is automatically changed</comment>
					<depends>
						<field id="auto_change_status">1</field>
					</depends>
				</field>
				<field id="notify_customer" translate="label comment" type="select" sortOrder="4" showInDefault="1" showInWebsite="1" showInStore="1">
					<label>Notify Customer</label>
					<source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
					<comment>Send email notification to customer when order status is changed to shipped</comment>
					<depends>
						<field id="auto_change_status">1</field>
					</depends>
				</field>
			</group>
		</section>
	</system>
</config>